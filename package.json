{
  "name": "root",
  "private": true,
  "type": "module",
  "module": "index.ts",
  "scripts": {
    "dev": "pnpm --filter xyo-editor dev",
    "build": "pnpm --filter @hikkaku/vm build && pnpm --filter xyo-editor build",
    "check": "pnpm --filter @hikkaku/vm check && pnpm --filter xyo-editor check",
    "test": "pnpm --filter @hikkaku/vm test",
    "test:compat": "pnpm --filter @hikkaku/vm test:compat",
    "test:performance": "pnpm --filter @hikkaku/vm test:performance",
    "test:browser": "pnpm --filter xyo-editor test:browser",
    "test:visual": "pnpm --filter xyo-editor test:visual",
    "fmt": "vp check --fix",
    "lint": "vp check"
  },
  "dependencies": {
    "vite-plus": "^0.1.21"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "packageManager": "pnpm@12.6.0"
}
