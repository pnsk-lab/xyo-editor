--- a/src/jit/llvm_compat.hpp
+++ b/src/jit/llvm_compat.hpp
@@ -1,12 +1,11 @@
 // xyo-cpp: LLVM のバージョン差を吸収する小さな互換ヘルパ。
 //
-// LLVM 19 で `TargetRegistry::lookupTarget` / `Target::createTargetMachine` /
-// `Module::setTargetTriple` が StringRef から `const Triple&` を取る形へ変わり、
-// `orc::ThreadSafeContext::withContextDo` が追加された。18 系（Ubuntu の
-// llvm-18-dev は静的アーカイブを同梱するため静的リンクに使える）でも
-// ビルドできるようにここで吸収する。
+// Upstream version compatibility plus a targeted LLVM 19.1.7 exception:
+// that release uses StringRef and getLock/getContext, despite the upstream
+// >=19 test. Other versions retain upstream behavior (not revalidated here).
 #pragma once
 
+#include <string>
 #include <llvm/ADT/ArrayRef.h>
 #include <llvm/ADT/StringRef.h>
 #include <llvm/Config/llvm-config.h>
@@ -19,7 +18,10 @@
 namespace xyo::llvmc {
 
 /// lookupTarget / createTargetMachine / setTargetTriple へ渡す三つ組引数。
-#if LLVM_VERSION_MAJOR >= 19
+#if LLVM_VERSION_MAJOR == 19 && LLVM_VERSION_MINOR == 1 && LLVM_VERSION_PATCH == 7
+using TripleArg = std::string;
+inline std::string tripleArg(const llvm::Triple& t) { return t.str(); }
+#elif LLVM_VERSION_MAJOR >= 19
 using TripleArg = const llvm::Triple&;
 inline const llvm::Triple& tripleArg(const llvm::Triple& t) { return t; }
 #else
@@ -28,10 +30,10 @@ inline llvm::StringRef tripleArg(const llvm::Triple& t) { return t.str(); }
 #endif
 
 /// ThreadSafeContext のロックを取って LLVMContext を渡す。
-/// LLVM 19+ は withContextDo、18 は getLock()+getContext() を使う。
+/// LLVM 19.1.7 は getLock()+getContext() を使う。
 template <typename Fn>
 inline void withContext(llvm::orc::ThreadSafeContext& tsc, Fn&& fn) {
-#if LLVM_VERSION_MAJOR >= 19
+#if LLVM_VERSION_MAJOR >= 19 && !(LLVM_VERSION_MAJOR == 19 && LLVM_VERSION_MINOR == 1 && LLVM_VERSION_PATCH == 7)
     tsc.withContextDo([&](llvm::LLVMContext* lc) { fn(lc); });
 #else
     auto lock = tsc.getLock();
